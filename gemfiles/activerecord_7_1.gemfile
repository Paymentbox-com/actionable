# frozen_string_literal: true

# ActiveRecord 7.1 lane (the `activerecord-7.1` job in .github/workflows/main.yml):
# the Rails adapter's transactions on the oldest supported ActiveRecord, and
# `after_commit` refusing it (it needs 7.2's after_all_transactions_commit).
# Same as the main Gemfile but with ActiveRecord / ActiveModel 7.1 and the
# sqlite3 1.x its SQLite adapter requires.
#
#   BUNDLE_GEMFILE=gemfiles/activerecord_7_1.gemfile bundle install
#   BUNDLE_GEMFILE=gemfiles/activerecord_7_1.gemfile bundle exec rspec
source 'https://rubygems.org'

gemspec path: '..'

# Same pin as the main Gemfile.
gem 'field_struct', git: 'https://github.com/Paymentbox-com/field_struct', tag: 'v0.12.0'

gem 'rake', '~> 13.0'
gem 'rspec', '~> 3.0'

gem 'activemodel', '~> 7.1.0', require: false
gem 'activerecord', '~> 7.1.0', require: false
gem 'sqlite3', '~> 1.4', require: false

# The suite's RBS specs parse sig/ (same pin as the main Gemfile).
gem 'rbs', '~> 3.0', require: false
