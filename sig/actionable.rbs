# Actionable: typed, composable Ruby service objects.
# 
# This is the core entry point. Per decision D14, every core file gets an
# explicit +require_relative+ here — no autoload, no Zeitwerk. The optional
# adapters (+actionable/rails+, +actionable/rspec+) are separate requires and
# are deliberately NOT loaded here, keeping the core Rails-free.
module Actionable
  # Run +block+ inside the halt catch point.
  # 
  # Returns the block's value when nothing is thrown, or the value passed with
  # +throw Actionable::HALT, value+ when the pipeline halts (+nil+ for a bare
  # +throw Actionable::HALT+). A raised StandardError is deliberately NOT
  # caught — it propagates to the caller (decision D4).
  # 
  # _@return_ — the block's value, or the thrown halt value
  def catch_halt: () -> Object

  # Run +block+ inside the halt catch point.
  # 
  # Returns the block's value when nothing is thrown, or the value passed with
  # +throw Actionable::HALT, value+ when the pipeline halts (+nil+ for a bare
  # +throw Actionable::HALT+). A raised StandardError is deliberately NOT
  # caught — it propagates to the caller (decision D4).
  # 
  # _@return_ — the block's value, or the thrown halt value
  def self.catch_halt: () -> Object

  # Namespace for the concrete step types an action's pipeline is built from
  # (decision D3): {Steps::Method} now, {Steps::Action} and {Steps::Case} later.
  module Steps
    # Build the right step type from a +step+ declaration's target, inferring
    # the type from the argument (decision D2): a Symbol/String becomes a
    # {Steps::Method}. Other targets (an action Class → {Steps::Action}, a
    # case block → {Steps::Case}) join in later slices.
    # 
    # _@param_ `target` — the step target
    # 
    # _@param_ `options` — step options (e.g. +:if+, +:unless+)
    # 
    # _@return_ — the constructed step
    def self.build: ((Symbol | String) target) -> Steps::Base

    # Shared behavior for every step: a +name+, an +options+ hash, value
    # identity for Set deduplication (keyed by +[type, name]+, decision D2),
    # and the +:if+ / +:unless+ skip logic. Subclasses implement {#call}.
    # 
    # @abstract Subclass and implement {#call}.
    class Base
      # _@param_ `name` — the step name (see {#name})
      # 
      # _@param_ `options` — step options
      def initialize: (Object name, **::Hash[Symbol, Object] options) -> void

      # Run the step against an action instance.
      # 
      # _@param_ `_instance` — the action instance the step runs against
      def call: (Object _instance) -> void

      # Whether this step should be skipped for the given instance, per its
      # +:if+ / +:unless+ guards. A guard is a Symbol naming a (possibly
      # private) instance method, or a callable invoked with the instance.
      # When both guards are present, either one asking to skip wins.
      # 
      # _@param_ `instance` — the action instance to evaluate guards against
      def skip?: (Object _instance) -> bool

      # Value identity: same concrete class AND same name. This keys steps in
      # the per-action Set so a redeclared step dedups (decision D2).
      # 
      # _@param_ `other`
      def ==: (Object other) -> bool

      # _@return_ — consistent with {#==}, so steps work as Set members
      def hash: () -> Integer

      # Resolve a guard against the instance. A Symbol/String names an instance
      # method (called via +__send__+, so private predicates work); anything
      # else is treated as a callable receiving the instance.
      # 
      # _@param_ `guard`
      # 
      # _@param_ `instance`
      def evaluate_guard: ((Symbol | String | untyped) guard, Object _instance) -> bool

      # _@return_ — the step's name — a Symbol for a {Steps::Method},
      # an action Class for a {Steps::Action}
      attr_reader name: Object

      # _@return_ — the declared step options (e.g. +:if+,
      # +:unless+, and step-type-specific keys)
      attr_reader options: ::Hash[Symbol, Object]
    end

    # A step that calls an instance method on the action (decision D3,
    # triggered by a Symbol/String step argument).
    class Method < Actionable::Steps::Base
      # _@param_ `name` — the instance method to call; normalized to a Symbol
      # 
      # _@param_ `options` — step options (e.g. +:if+, +:unless+)
      def initialize: ((Symbol | String) name) -> void

      # Invoke the named method on the instance.
      # 
      # _@param_ `instance` — the action instance
      # 
      # _@return_ — the method's return value
      def call: (Object _instance) -> Object
    end
  end

  # Base class for service objects. Subclass it, declare an ordered list of
  # steps with {.step}, implement each step as an instance method, and run it
  # with {.run} (decisions D1/D2).
  # 
  #   class Greet < Actionable::Action
  #     step :build_message
  #     def build_message = @message = 'hello'
  #   end
  # 
  #   Greet.run # => #<Actionable::Success ...>
  class Action
    # The ordered, deduplicated set of steps declared on this action.
    # A {Set} keyed by step identity ([type, name]) so a redeclared step
    # collapses to one entry; insertion order is preserved (decision D2).
    def self.steps: () -> ::Set[Steps::Base]

    # Declare a step. The step type is inferred from +target+ (a Symbol or
    # String names an instance method — a {Steps::Method}).
    # 
    # _@param_ `target` — the step target
    # 
    # _@param_ `options` — step options (e.g. +:if+, +:unless+)
    # 
    # _@return_ — the updated step set
    def self.step: ((Symbol | String) target) -> ::Set[Steps::Base]

    # Instantiate the action with the given arguments and run it.
    # 
    # _@return_ — the run's {Success} or {Failure}
    def self.run: () -> Result

    # Give each subclass its own copy of the inherited step set, so adding
    # steps to a subclass never mutates the parent's (decision D2).
    # 
    # _@param_ `subclass`
    def self.inherited: (Class subclass) -> void

    # Default free-form constructor: accept and ignore any arguments, so an
    # action with no declared input still runs via {.run}. Subclasses override
    # this to capture their inputs (decision D7; typed input lands in a later
    # slice).
    def initialize: (*untyped _args, **untyped _kwargs) -> void

    # Record a {Failure} as the run's result without halting — later steps
    # still run, and the final result reflects the most recent record (decision
    # D4, "last write wins").
    # 
    # _@param_ `code` — the error code
    # 
    # _@param_ `message` — human-readable description
    # 
    # _@param_ `errors` — field => message(s) added to the result's errors collection
    # 
    # _@return_ — so a step can branch on the call
    def fail: (Symbol code, ?String? message, **::Hash[Symbol, (String | ::Array[String])] errors) -> bool

    # Record a {Success} as the run's result without halting (decision D4).
    # 
    # _@param_ `message` — human-readable description
    # 
    # _@param_ `output` — the success output payload
    # 
    # _@return_ — so a step can branch on the call
    def succeed: (?String? message, **::Hash[Symbol, Object] output) -> bool

    # Record a {Failure} and halt the run, skipping the remaining steps
    # (decision D4).
    # 
    # _@param_ `code` — the error code
    # 
    # _@param_ `message` — human-readable description
    # 
    # _@param_ `errors` — field => message(s)
    def fail!: (Symbol code, ?String? message, **::Hash[Symbol, (String | ::Array[String])] errors) -> void

    # Record a {Success} and halt the run, skipping the remaining steps
    # (decision D4).
    # 
    # _@param_ `message` — human-readable description
    # 
    # _@param_ `output` — the success output payload
    def succeed!: (?String? message, **::Hash[Symbol, Object] output) -> void

    # Halt the run immediately, keeping whatever result was already recorded
    # (a prior +fail+/+succeed+, or auto-{Success} if none). Control flow only —
    # not an exception (decision D4).
    def halt!: () -> void

    # The result recorded during the run, if any. The control-flow methods
    # (+fail+/+succeed+/+fail!+/+succeed!+) write here; +nil+ means "no explicit
    # result", which the {Runner} turns into an auto-{Success}.
    attr_reader result: Result?
  end

  # Base class for every error this gem raises. Rescue +Actionable::Error+ to
  # catch the whole family. Genuine errors are never caught by the runner for
  # control flow — they propagate to the caller (decision D4).
  class Error < StandardError
  end

  # The single value object a run returns. {Success} and {Failure} are the
  # concrete subclasses; +Result+ itself is abstract and defines the shared,
  # FieldStruct-backed shape (decision D5).
  # 
  # @abstract Instantiate {Success} or {Failure}, not +Result+ directly.
  class Result < FieldStruct::Base
    # _@return_ — +:success+ for a {Success}; the error symbol for a {Failure}
    def code: () -> Symbol

    # _@return_ — human-readable description of the outcome
    def message: () -> String?

    # _@return_ — the run's declared, typed output payload (empty by default).
    # Firms up into an output FieldStruct once output schemas land (D6).
    def output: () -> Object

    # _@return_ — the run's execution history (empty by default).
    # Firms up into a +History+ once measurement lands (D10).
    def history: () -> Object

    # _@return_ — whether the run succeeded. Abstract here; each
    # subclass flips the predicate that applies to it.
    def success?: () -> bool

    # _@return_ — whether the run failed.
    def failure?: () -> bool

    # _@return_ — alias of {#success?}
    def successful?: () -> bool

    # _@return_ — alias of {#failure?}
    def failed?: () -> bool

    # _@return_ — a compact, field-sorted, deterministic representation —
    # the declared attributes plus the +errors+ collection, sorted by name,
    # so equal results always render identically.
    def inspect: () -> String

    # _@return_ — same deterministic representation as {#inspect}
    def to_s: () -> String
  end

  # Executes an action instance's steps and produces the {Result}.
  # 
  # The main loop runs inside {Actionable.catch_halt}, so a halting step
  # (+throw Actionable::HALT+) unwinds out of the loop without running the
  # remaining steps. Genuine exceptions are not caught — they propagate to the
  # caller (decision D4). When no step recorded a result, the run auto-succeeds.
  class Runner
    # _@param_ `instance` — the action instance to run
    def initialize: (Action _instance) -> void

    # Run the action's steps and return its result.
    # 
    # _@return_ — the recorded result, or a fresh {Success} if none was set
    def run: () -> Result

    # Run each declared step in order, skipping any whose guard opts out.
    def run_steps: () -> void
  end

  # A failed run's result. Its +code+ is the error symbol describing why the
  # run failed (e.g. +:not_found+, +:invalid_input+), defaulting to +:error+.
  class Failure < Actionable::Result
    # _@return_ — the error code; defaults to +:error+
    def code: () -> Symbol

    def failure?: () -> bool
  end

  # A successful run's result. Its +code+ defaults to +:success+.
  class Success < Actionable::Result
    # _@return_ — always +:success+ unless explicitly overridden
    def code: () -> Symbol

    def success?: () -> bool
  end
end